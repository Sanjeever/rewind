{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "bracketSpacing": false,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".cache/",
    "android/",
    "assets/",
    "website/",
    "pnpm-lock.yaml",
    "handoff.md",
    "AGENTS.md"
  ]
}
