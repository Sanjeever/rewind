    "lrc-kit": "1.2.1",
    "pinyin-pro": "3.27.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-animatable": "1.4.0",
    "react-native-blob-util": "0.25.1",
    "react-native-image-crop-picker": "0.52.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-pager-view": "9.0.11",
    "react-native-popup-menu": "0.19.0",
    "react-native-safe-area-context": "5.11.0",
    "react-native-screens": "4.30.1",
    "react-native-storage": "1.0.1",
    "react-native-tab-view": "4.3.4",
    "react-native-text-ticker": "1.14.0",
    "react-native-touchable-scale": "2.2.0",
    "react-native-vector-icons": "10.3.0",
    "react-native-video": "6.19.3",
    "react-native-webview": "14.0.1",
    "spark-md5": "3.0.2",
    "zod": "4.6.7"
