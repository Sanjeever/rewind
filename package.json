{
  "name": "rewind",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "bundle:android": "react-native bundle --platform android --entry-file index.js --dev false --bundle-output .cache/metro/index.android.bundle --assets-dest .cache/metro/assets",
    "android:build": "node scripts/android.mjs assembleDebug",
    "android:install": "node scripts/android.mjs installDebug",
    "android:build:standalone": "node scripts/android.mjs assembleStandalone",
    "android:install:standalone": "node scripts/android.mjs installStandalone",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test --runInBand",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "@react-native-async-storage/async-storage": "3.1.1",
