{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".cache", "android", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
